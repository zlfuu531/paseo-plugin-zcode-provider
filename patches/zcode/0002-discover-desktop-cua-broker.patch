   const refreshMarker = env["ZCODE_CUA_PERMISSION_BROKER_REFRESH_MARKER"]?.trim();
+  // paseo-plugin-zcode-provider (fork): the standalone Server strips broker
+  // credentials before spawning the agent, so recover the running Desktop
